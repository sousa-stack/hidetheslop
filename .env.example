# Copy to .env on the droplet. Never commit .env.
POSTGRES_USER=hidetheslop
# openssl rand -hex 32. Hex, because this goes into a URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hidetheslop

# Let's Encrypt writes here about certificates.
ACME_EMAIL=you@example.com

# How many votes confirm a picture. Stays 5 outside testing, and the API warns at startup
# when it isn't. Expiry stays at 5 votes either way, because that's a public promise.
CONFIRM_MIN_VOTES=5

# An encrypted copy of each nightly dump, off the droplet. Leave BACKUP_REMOTE empty to keep
# dumps on the droplet only. docs/CROWD-API.md has the steps for the bucket.
BACKUP_REMOTE=
# Long random text, each different: openssl rand -hex 32. Keep both in a password manager.
# Losing them loses the backups: nothing can decrypt the dumps without them.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_PASSWORD2=
# Optional. An Uptime Kuma push URL, called after a good run, so a missed night is noticed.
BACKUP_PING_URL=
# The bucket behind the encrypted copy, in rclone's own settings. Only used with BACKUP_REMOTE,
# which for this bucket is backupstore:hidetheslop-backups/dumps
RCLONE_CONFIG_BACKUPSTORE_TYPE=s3
RCLONE_CONFIG_BACKUPSTORE_PROVIDER=Cloudflare
RCLONE_CONFIG_BACKUPSTORE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_BACKUPSTORE_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUPSTORE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUPSTORE_NO_CHECK_BUCKET=true
